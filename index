  <script>
(function () {
  var STORAGE_KEY = "doomsday-checklist-v1";
  var CYCLE = ["W", "N", "P", "X", "R"];
  var WATCH_LABEL = {
    W: "Watched",
    N: "Not watched",
    P: "Partial",
    X: "Excluded",
    R: "Review summary"
  };
  var TAB_LABEL = {
    all: "All",
    E: "Essential",
    R: "Recommended",
    D: "Deep cut",
    S: "Skippable",
    sW: "Watched",
    sN: "Not watched",
    sP: "Partial",
    sX: "Excluded",
    sR: "Review summary"
  };
  var MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

  var defaultsBlock = JSON.parse(document.getElementById("default-status-data").textContent);
  var DEFAULT_STATUS = defaultsBlock.status;
  var DEFAULTS_VERSION = defaultsBlock.version;

  var tabButtons = Array.from(document.querySelectorAll("[data-tab]"));
  var typeSelect = document.getElementById("type-filter");
  var hideToggle = document.getElementById("hide-watched");
  var rows = Array.from(document.querySelectorAll("#checklist-body tr"));
  var viewLine = document.getElementById("view-line");
  var empty = document.getElementById("empty-filter");
  var printHeader = document.getElementById("print-header");
  var resetBtn = document.getElementById("reset-defaults");
  var downloadBtn = document.getElementById("download-updated");
  var printBtn = document.getElementById("print-checklist");
  var tab = "all";

  // FNV-1a 32-bit over UTF-16 code units of a canonical title/status list.
  // A baked file writes a new version; load ignores overrides saved under a different version
  // so stale localStorage from an older default set cannot override the baked defaults.
  function hashDefaults(status) {
    var keys = Object.keys(status).sort();
    var canon = keys.map(function (k) { return k + "\t" + status[k]; }).join("\n");
    var h = 2166136261;
    var i;
    for (i = 0; i < canon.length; i++) {
      h ^= canon.charCodeAt(i);
      h = Math.imul(h, 16777619);
    }
    return (h >>> 0).toString(16).padStart(8, "0");
  }

  function isStatus(value) {
    return Object.prototype.hasOwnProperty.call(WATCH_LABEL, value);
  }

  function loadOverrides() {
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return {};
      var parsed = JSON.parse(raw);
      if (!parsed || typeof parsed !== "object") return {};
      if (parsed.defaultsVersion !== DEFAULTS_VERSION) return {};
      var src = parsed.overrides;
      if (!src || typeof src !== "object") return {};
      var clean = {};
      Object.keys(src).forEach(function (title) {
        var st = src[title];
        if (
          Object.prototype.hasOwnProperty.call(DEFAULT_STATUS, title) &&
          isStatus(st) &&
          st !== DEFAULT_STATUS[title]
        ) {
          clean[title] = st;
        }
      });
      return clean;
    } catch (err) {
      return {};
    }
  }

  function saveOverrides(overrides) {
    var clean = {};
    Object.keys(overrides).forEach(function (title) {
      var st = overrides[title];
      if (
        Object.prototype.hasOwnProperty.call(DEFAULT_STATUS, title) &&
        isStatus(st) &&
        st !== DEFAULT_STATUS[title]
      ) {
        clean[title] = st;
      }
    });
    try {
      if (Object.keys(clean).length === 0) {
        localStorage.removeItem(STORAGE_KEY);
      } else {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({
          defaultsVersion: DEFAULTS_VERSION,
          overrides: clean
        }));
      }
    } catch (err) {
      /* private mode or blocked storage: keep the on-page change anyway */
    }
  }

  function rowTitle(row) {
    return row.getAttribute("data-title");
  }

  function statusOf(row) {
    return row.getAttribute("data-status");
  }

  function ariaFor(title, st, edited) {
    var label = title + ", " + WATCH_LABEL[st];
    if (edited) label += ", edited from default";
    return label + ". Activate to cycle status.";
  }

  function setRowStatus(row, st, persistAll) {
    var title = rowTitle(row);
    var def = DEFAULT_STATUS[title];
    var edited = st !== def;
    row.setAttribute("data-status", st);
    var btn = row.querySelector("button.status-btn");
    btn.className = "pill status-btn pill-" + st;
    btn.textContent = WATCH_LABEL[st];
    btn.setAttribute("aria-label", ariaFor(title, st, edited));
    var mark = row.querySelector(".edited-mark");
    if (mark) {
      if (edited) mark.removeAttribute("hidden");
      else mark.setAttribute("hidden", "");
    }
    if (persistAll) {
      var overrides = {};
      rows.forEach(function (r) {
        var t = rowTitle(r);
        var s = statusOf(r);
        if (s !== DEFAULT_STATUS[t]) overrides[t] = s;
      });
      saveOverrides(overrides);
    }
  }

  function cycleStatus(row) {
    var current = statusOf(row);
    var i = CYCLE.indexOf(current);
    var next = CYCLE[(i < 0 ? 0 : i + 1) % CYCLE.length];
    setRowStatus(row, next, true);
    apply();
  }

  function matchTab(row) {
    if (tab === "all") return true;
    if (tab.length === 2 && tab.charAt(0) === "s") {
      return statusOf(row) === tab.charAt(1);
    }
    return row.getAttribute("data-tier") === tab;
  }

  function formatPrintDate(d) {
    return MONTHS[d.getMonth()] + " " + d.getDate() + ", " + d.getFullYear();
  }

  function updatePrintHeader() {
    if (!printHeader) return;
    var parts = ["Filter: " + (TAB_LABEL[tab] || tab)];
    if (typeSelect.value !== "All types") parts.push("Type: " + typeSelect.value);
    if (hideToggle.checked) parts.push("Hide watched");
    parts.push("Printed " + formatPrintDate(new Date()));
    printHeader.textContent = parts.join(" · ");
  }

  function apply() {
    var typ = typeSelect.value;
    var hideSeen = hideToggle.checked;
    var inScope = 0;
    var seenInScope = 0;
    var visible = 0;
    var essentialSeen = 0;
    var essentialTotal = 0;
    var counts = { W: 0, N: 0, P: 0, X: 0, R: 0 };

    rows.forEach(function (row) {
      var st = statusOf(row);
      counts[st] += 1;
      if (row.getAttribute("data-tier") === "E") {
        essentialTotal += 1;
        if (st === "W") essentialSeen += 1;
      }
      var okTab = matchTab(row);
      var okType = typ === "All types" || row.getAttribute("data-type") === typ;
      var inThis = okTab && okType;
      if (inThis) {
        inScope += 1;
        if (st === "W") seenInScope += 1;
      }
      var show = inThis && !(hideSeen && st === "W");
      row.hidden = !show;
      if (show) visible += 1;
    });

    tabButtons.forEach(function (btn) {
      var t = btn.getAttribute("data-tab");
      btn.setAttribute("aria-pressed", t === tab ? "true" : "false");
      if (t.length === 2 && t.charAt(0) === "s") {
        var span = btn.querySelector(".count");
        if (span) span.textContent = String(counts[t.charAt(1)]);
      }
    });

    viewLine.textContent =
      "Watched: " + seenInScope + " of " + inScope + " in this view · Essentials: " +
      essentialSeen + " of " + essentialTotal;

    empty.classList.toggle("visible", visible === 0);
    updatePrintHeader();
  }

  function resetToDefaults() {
    if (!window.confirm("Reset all statuses to the defaults and clear saved changes on this device?")) {
      return;
    }
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch (err) { /* ignore */ }
    rows.forEach(function (row) {
      setRowStatus(row, DEFAULT_STATUS[rowTitle(row)], false);
    });
    apply();
  }

  function bakeHtml() {
    var merged = {};
    rows.forEach(function (row) {
      merged[rowTitle(row)] = statusOf(row);
    });
    var version = hashDefaults(merged);
    var clone = document.documentElement.cloneNode(true);
    var dataEl = clone.querySelector("#default-status-data");
    dataEl.textContent = JSON.stringify({ version: version, status: merged });

    var counts = { W: 0, N: 0, P: 0, X: 0, R: 0 };
    var essentialSeen = 0;
    var essentialTotal = 0;

    Array.from(clone.querySelectorAll("#checklist-body tr")).forEach(function (row) {
      row.removeAttribute("hidden");
      var title = row.getAttribute("data-title");
      var st = merged[title];
      row.setAttribute("data-status", st);
      var btn = row.querySelector("button.status-btn");
      btn.className = "pill status-btn pill-" + st;
      btn.textContent = WATCH_LABEL[st];
      btn.setAttribute("aria-label", title + ", " + WATCH_LABEL[st] + ". Activate to cycle status.");
      var mark = row.querySelector(".edited-mark");
      if (mark) mark.setAttribute("hidden", "");
      counts[st] += 1;
      if (row.getAttribute("data-tier") === "E") {
        essentialTotal += 1;
        if (st === "W") essentialSeen += 1;
      }
    });

    Array.from(clone.querySelectorAll("[data-tab]")).forEach(function (btn) {
      var t = btn.getAttribute("data-tab");
      btn.setAttribute("aria-pressed", t === "all" ? "true" : "false");
      if (t.length === 2 && t.charAt(0) === "s") {
        var span = btn.querySelector(".count");
        if (span) span.textContent = String(counts[t.charAt(1)]);
      }
    });

    var typeSel = clone.querySelector("#type-filter");
    if (typeSel) {
      typeSel.value = "All types";
      Array.from(typeSel.options).forEach(function (opt) {
        if (opt.value === "All types") opt.setAttribute("selected", "selected");
        else opt.removeAttribute("selected");
      });
    }

    var hide = clone.querySelector("#hide-watched");
    if (hide) {
      hide.checked = false;
      hide.removeAttribute("checked");
    }

    var emptyEl = clone.querySelector("#empty-filter");
    if (emptyEl) emptyEl.classList.remove("visible");

    var n = Object.keys(merged).length;
    var viewEl = clone.querySelector("#view-line");
    if (viewEl) {
      viewEl.textContent =
        "Watched: " + counts.W + " of " + n + " in this view · Essentials: " +
        essentialSeen + " of " + essentialTotal;
    }

    var printEl = clone.querySelector("#print-header");
    if (printEl) printEl.textContent = "";

    return "<!DOCTYPE html>\n" + clone.outerHTML + "\n";
  }

  function downloadUpdated() {
    var html = bakeHtml();
    var blob = new Blob([html], { type: "text/html;charset=utf-8" });
    var url = URL.createObjectURL(blob);
    var a = document.createElement("a");
    a.href = url;
    a.download = "avengers-doomsday-checklist.html";
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
  }

  rows.forEach(function (row) {
    row.querySelector("button.status-btn").addEventListener("click", function () {
      cycleStatus(row);
    });
  });

  var initialOverrides = loadOverrides();
  rows.forEach(function (row) {
    var title = rowTitle(row);
    var st = initialOverrides[title] || DEFAULT_STATUS[title] || "N";
    setRowStatus(row, st, false);
  });

  tabButtons.forEach(function (btn) {
    btn.addEventListener("click", function () {
      tab = btn.getAttribute("data-tab");
      apply();
    });
  });
  typeSelect.addEventListener("change", apply);
  hideToggle.addEventListener("change", apply);
  resetBtn.addEventListener("click", resetToDefaults);
  downloadBtn.addEventListener("click", downloadUpdated);
  printBtn.addEventListener("click", function () {
    updatePrintHeader();
    window.print();
  });
  window.addEventListener("beforeprint", updatePrintHeader);

  apply();
})();

  </script>
