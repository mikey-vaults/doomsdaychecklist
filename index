<title>Avengers: Doomsday Viewing Checklist</title>
<style>

:root {
  --bg: #f3f0e8;
  --surface: #fffcf6;
  --surface-2: #efebe1;
  --ink: #171512;
  --muted: #5c574e;
  --line: #ddd6c7;
  --line-strong: #c9c0ae;
  --accent: #1d4ed8;
  --accent-soft: #dbe7ff;
  --shadow: 0 1px 2px rgba(23, 21, 18, 0.06), 0 8px 24px rgba(23, 21, 18, 0.06);
  --pill-w-bg: #dcfce7;
  --pill-w-fg: #14532d;
  --pill-p-bg: #fef3c7;
  --pill-p-fg: #854d0e;
  --pill-x-bg: #fee2e2;
  --pill-x-fg: #991b1b;
  --pill-r-bg: #dbeafe;
  --pill-r-fg: #1e40af;
  --pill-n-bg: #e8e6e1;
  --pill-n-fg: #44403c;
  --pill-e-bg: #dbeafe;
  --pill-e-fg: #1e40af;
  --callout-bg: #fff7e6;
  --callout-border: #d97706;
  --focus: 0 0 0 3px rgba(29, 78, 216, 0.35);
  color-scheme: light dark;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #12141a;
    --surface: #1b1f28;
    --surface-2: #242833;
    --ink: #f2efe8;
    --muted: #b0aa9e;
    --line: #333845;
    --line-strong: #4a5060;
    --accent: #7aa2ff;
    --accent-soft: #1c2a4d;
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.35), 0 8px 24px rgba(0, 0, 0, 0.28);
    --pill-w-bg: #14532d;
    --pill-w-fg: #bbf7d0;
    --pill-p-bg: #713f12;
    --pill-p-fg: #fde68a;
    --pill-x-bg: #7f1d1d;
    --pill-x-fg: #fecaca;
    --pill-r-bg: #1e3a8a;
    --pill-r-fg: #bfdbfe;
    --pill-n-bg: #3f3f46;
    --pill-n-fg: #e4e4e7;
    --pill-e-bg: #1e3a8a;
    --pill-e-fg: #bfdbfe;
    --callout-bg: #2a2114;
    --callout-border: #fbbf24;
    --focus: 0 0 0 3px rgba(122, 162, 255, 0.45);
  }
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
}

body {
  font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  background: var(--bg);
  color: var(--ink);
  line-height: 1.5;
  font-size: 16px;
  -webkit-text-size-adjust: 100%;
}

a { color: var(--accent); }
a:hover { text-decoration-thickness: 2px; }

.wrap {
  max-width: 1180px;
  margin: 0 auto;
  padding: 1.5rem 1.15rem 3rem;
}

header.page-header {
  margin-bottom: 1.75rem;
  padding-bottom: 1.15rem;
  border-bottom: 3px solid var(--ink);
}

header.page-header p.kicker {
  margin: 0 0 0.35rem;
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--muted);
}

h1 {
  margin: 0 0 0.6rem;
  font-size: clamp(1.6rem, 3.5vw, 2.25rem);
  line-height: 1.15;
  letter-spacing: -0.02em;
}

.lede {
  margin: 0;
  max-width: 48rem;
  color: var(--muted);
  font-size: 1.02rem;
}

h2 {
  margin: 0 0 0.9rem;
  font-size: 1.25rem;
  letter-spacing: -0.015em;
}

section.block {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 1.15rem 1.15rem 1.25rem;
  box-shadow: var(--shadow);
  margin-bottom: 1.25rem;
}

/* Filters */
.filters { margin-bottom: 0.85rem; }

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
  align-items: center;
  margin-bottom: 0.55rem;
}

.filter-row.tools {
  margin-top: 0.25rem;
  padding-top: 0.7rem;
  border-top: 1px solid var(--line);
  justify-content: space-between;
  gap: 0.75rem 1.25rem;
}

.seg {
  appearance: none;
  border: 1px solid var(--line-strong);
  background: var(--surface);
  color: var(--ink);
  border-radius: 999px;
  padding: 0.35rem 0.7rem;
  font: inherit;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  line-height: 1.3;
  white-space: nowrap;
}

.seg:hover { background: var(--surface-2); }

.seg[aria-pressed="true"] {
  background: var(--ink);
  color: var(--bg);
  border-color: var(--ink);
}

.seg .count {
  display: inline-block;
  margin-left: 0.28rem;
  font-variant-numeric: tabular-nums;
  font-weight: 650;
  opacity: 0.75;
  font-size: 0.78em;
}

.seg[aria-pressed="true"] .count { opacity: 0.9; }

.seg:focus-visible, .toggle input:focus-visible + .switch, select:focus-visible {
  outline: none;
  box-shadow: var(--focus);
}

.type-field {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  margin-left: auto;
  font-size: 0.875rem;
  font-weight: 600;
}

.type-field label { color: var(--muted); font-weight: 600; }

select {
  font: inherit;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--ink);
  background: var(--surface);
  border: 1px solid var(--line-strong);
  border-radius: 8px;
  padding: 0.35rem 0.55rem;
}

.view-line {
  margin: 0;
  color: var(--muted);
  font-size: 0.92rem;
  font-variant-numeric: tabular-nums;
}

/* Toggle */
.toggle {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  cursor: pointer;
  font-size: 0.92rem;
  font-weight: 600;
  user-select: none;
}

.toggle input {
  position: absolute;
  opacity: 0;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
}

.switch {
  width: 2.4rem;
  height: 1.35rem;
  border-radius: 999px;
  background: var(--line-strong);
  position: relative;
  flex: none;
  transition: background 0.15s ease;
}

.switch::after {
  content: "";
  position: absolute;
  top: 2px;
  left: 2px;
  width: calc(1.35rem - 4px);
  height: calc(1.35rem - 4px);
  border-radius: 50%;
  background: var(--surface);
  box-shadow: 0 1px 2px rgba(0,0,0,0.2);
  transition: transform 0.15s ease;
}

.toggle input:checked + .switch { background: var(--accent); }
.toggle input:checked + .switch::after { transform: translateX(1.05rem); }

/* Table */
.table-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border: 1px solid var(--line);
  border-radius: 10px;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 860px;
  font-size: 0.9rem;
}

thead th {
  position: sticky;
  top: 0;
  background: var(--surface-2);
  text-align: left;
  font-size: 0.75rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--muted);
  padding: 0.6rem 0.7rem;
  border-bottom: 1px solid var(--line-strong);
  white-space: nowrap;
  z-index: 1;
}

tbody td {
  padding: 0.55rem 0.7rem;
  border-bottom: 1px solid var(--line);
  vertical-align: top;
}

tbody tr:last-child td { border-bottom: 0; }
tbody tr:nth-child(even) { background: color-mix(in srgb, var(--surface-2) 55%, transparent); }

td.title { font-weight: 650; min-width: 13rem; }
td.released, td.type-col { white-space: nowrap; color: var(--muted); }
td.note { color: var(--ink); min-width: 16rem; }

.pill {
  display: inline-block;
  border-radius: 999px;
  padding: 0.12rem 0.55rem;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.01em;
  line-height: 1.4;
  white-space: nowrap;
}

.pill-W { background: var(--pill-w-bg); color: var(--pill-w-fg); }
.pill-P { background: var(--pill-p-bg); color: var(--pill-p-fg); }
.pill-X { background: var(--pill-x-bg); color: var(--pill-x-fg); }
.pill-R { background: var(--pill-r-bg); color: var(--pill-r-fg); }
.pill-N { background: var(--pill-n-bg); color: var(--pill-n-fg); }
.pill-tier { background: var(--pill-n-bg); color: var(--pill-n-fg); }
.pill-tier-E { background: var(--pill-e-bg); color: var(--pill-e-fg); }

button.status-btn {
  appearance: none;
  -webkit-appearance: none;
  margin: 0;
  font-family: inherit;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.01em;
  line-height: 1.4;
  cursor: pointer;
  border: 1px solid transparent;
  color: inherit;
}
button.status-btn:hover {
  box-shadow: inset 0 0 0 1px currentColor;
}
button.status-btn:focus-visible {
  outline: none;
  box-shadow: var(--focus);
}

.status-wrap {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  white-space: nowrap;
}

.edited-mark {
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--accent);
  border: 1px solid var(--accent);
  border-radius: 999px;
  padding: 0 0.35rem;
  line-height: 1.4;
}

.tools-left {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.55rem 0.75rem;
}

.action-btn {
  appearance: none;
  font: inherit;
  font-size: 0.82rem;
  font-weight: 650;
  color: var(--ink);
  background: var(--surface);
  border: 1px solid var(--line-strong);
  border-radius: 8px;
  padding: 0.35rem 0.65rem;
  cursor: pointer;
  white-space: nowrap;
}
.action-btn:hover { background: var(--surface-2); }
.action-btn:focus-visible { outline: none; box-shadow: var(--focus); }

.print-header { display: none; }

@page { margin: 0.6in 0.55in; }

@media print {
  * {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  html, body {
    background: #fff !important;
    color: #000 !important;
  }
  .wrap { max-width: none; padding: 0; margin: 0; }
  .filters, .no-print, .action-btn, .toggle, .type-field { display: none !important; }
  header.page-header {
    border-bottom: 2px solid #000;
    margin-bottom: 0.45rem;
    padding-bottom: 0.35rem;
  }
  header.page-header p.kicker,
  header.page-header .lede { color: #000; }
  .print-header {
    display: block !important;
    margin: 0 0 0.7rem;
    font-size: 10pt;
    color: #000;
  }
  section.block {
    background: #fff !important;
    box-shadow: none;
    border: 1px solid #ccc;
    margin-bottom: 0.8rem;
    break-inside: avoid;
    page-break-inside: avoid;
  }
  section.checklist-block {
    break-inside: auto;
    page-break-inside: auto;
    border: none;
    padding: 0.2rem 0 0.6rem;
  }
  .table-wrap {
    overflow: visible;
    border: none;
  }
  table {
    min-width: 0;
    width: 100%;
    font-size: 9.5pt;
  }
  thead { display: table-header-group; }
  thead th {
    background: #eee !important;
    color: #000;
    position: static;
    border-bottom: 1px solid #444;
  }
  tbody tr {
    break-inside: avoid;
    page-break-inside: avoid;
  }
  tbody td, tbody td.released, tbody td.type-col, tbody td.note, .lede, .table-note {
    color: #000;
  }
  tbody tr:nth-child(even) { background: #f3f3f3 !important; }
  button.status-btn, .pill {
    box-shadow: none;
    border: 1px solid #444;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .edited-mark {
    color: #000;
    border-color: #000;
  }
  a { color: #000; text-decoration: underline; }
  footer.page-footer { color: #000; }
}


.empty {
  display: none;
  margin: 0.75rem 0 0;
  color: var(--muted);
  font-size: 0.95rem;
}

.empty.visible { display: block; }

.table-note {
  margin: 0.75rem 0 0;
  color: var(--muted);
  font-size: 0.85rem;
}

/* Glance */
.glance {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem 2rem;
}

@media (max-width: 720px) {
  .glance { grid-template-columns: 1fr; }
  .type-field { margin-left: 0; }
}

dl.props {
  margin: 0;
}

dl.props div {
  display: grid;
  grid-template-columns: 9.5rem 1fr;
  gap: 0.35rem 0.85rem;
  padding: 0.55rem 0;
  border-bottom: 1px solid var(--line);
}

dl.props div:first-child { padding-top: 0; }
dl.props div:last-child { border-bottom: 0; padding-bottom: 0; }

dl.props dt {
  margin: 0;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--muted);
}

dl.props dd { margin: 0; }

@media (max-width: 520px) {
  dl.props div { grid-template-columns: 1fr; gap: 0.15rem; }
}

/* Lists */
ol.essentials, ul.notes, ul.sources {
  margin: 0;
  padding-left: 1.25rem;
}

ol.essentials li, ul.notes li, ul.sources li {
  margin: 0.4rem 0;
}

.callout {
  margin-top: 1rem;
  background: var(--callout-bg);
  border-left: 4px solid var(--callout-border);
  border-radius: 0 10px 10px 0;
  padding: 0.85rem 1rem;
}

.callout .lead {
  font-weight: 800;
  margin: 0 0 0.25rem;
}

.callout p { margin: 0; }

footer.page-footer {
  margin-top: 0.5rem;
  padding: 0.5rem 0.25rem 0;
  color: var(--muted);
  font-size: 0.85rem;
}

footer.page-footer p { margin: 0.35rem 0; }

</style>
</head>
